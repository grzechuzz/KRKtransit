<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>pl.krktransit</groupId>
    <artifactId>gtfs-schedule-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>GTFS Schedule</name>
    <description>Versioned GTFS imports and private schedule reads.</description>
    <modules>
        <module>schedule-core</module>
        <module>schedule-contracts</module>
        <module>schedule-service</module>
        <module>realtime-contracts</module>
        <module>realtime-ingestion-service</module>
        <module>stop-events-service</module>
    </modules>
    <properties>
        <java.version>25</java.version>
        <skipTests>false</skipTests>
        <skipUnitTests>${skipTests}</skipUnitTests>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pl.krktransit</groupId>
                <artifactId>schedule-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.krktransit</groupId>
                <artifactId>schedule-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.krktransit</groupId>
                <artifactId>realtime-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipUnitTests}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
